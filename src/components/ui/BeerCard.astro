---
import type { CollectionEntry } from 'astro:content';
import BeerCan from './BeerCan.astro';

interface Props {
  beer: CollectionEntry<'beers'>;
  headingLevel?: 2 | 3;
}

const { beer, headingLevel = 2 } = Astro.props;
const { name, canLabel, canColor, description, abv, ibu } = beer.data;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const stats = abv === null || ibu === null ? 'ABV and IBU vary' : `ABV ${abv.toFixed(1)}% | IBU ${ibu}`;
---

<a
  href={`/beers/${beer.id}/`}
  class="group flex h-full flex-col border border-pub/20 bg-parchment/50 p-5 text-center transition-colors hover:border-pub"
>
  <BeerCan label={canLabel} color={canColor} class="mx-auto w-28" />
  <Heading class="mt-4 text-xl uppercase group-hover:underline">{name}</Heading>
  <p class="mt-2 grow text-sm">{description}</p>
  <p class="mt-3 text-sm font-semibold">{stats}</p>
</a>
