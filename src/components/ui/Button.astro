---
interface Props {
  href: string;
  /** primary: main action. secondary: lesser action on a dark surface. outline: lesser action on cream. */
  variant?: 'primary' | 'secondary' | 'outline';
}

const { href, variant = 'primary' } = Astro.props;

const variants = {
  primary: 'border-brass bg-celtic text-cream hover:bg-pub',
  secondary: 'border-cream text-cream hover:bg-ink',
  outline: 'border-pub text-pub hover:bg-pub hover:text-cream',
};
---

<a
  href={href}
  class:list={[
    'inline-block border-2 px-6 py-3 text-center text-sm font-semibold tracking-wider uppercase transition-colors',
    variants[variant],
  ]}
>
  <slot />
</a>
