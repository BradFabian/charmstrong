---
import { getCollection } from 'astro:content';
import HeroBand from '../components/sections/HeroBand.astro';
import BeerCan from '../components/ui/BeerCan.astro';
import Button from '../components/ui/Button.astro';
import PlaceholderNote from '../components/ui/PlaceholderNote.astro';
import Section from '../components/ui/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const beers = (await getCollection('beers')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
---

<BaseLayout>
  <HeroBand
    eyebrow="Boston, Massachusetts"
    heading="European Brewing Tradition."
    subheading="Boston Character."
    intro="Classic beer styles brewed with Old World tradition and New England spirit."
  >
    <Fragment slot="actions">
      <Button href="/beers/">Explore Our Beers</Button>
      <Button href="/our-story/" variant="secondary">Our Story</Button>
    </Fragment>
    <div slot="media" class="flex items-end justify-center gap-3">
      {beers.map((beer) => <BeerCan label={beer.data.canLabel} color={beer.data.canColor} class="w-1/3 max-w-32" />)}
    </div>
  </HeroBand>
  <Section>
    <PlaceholderNote>The rest of the home page is delivered in the Home feature.</PlaceholderNote>
  </Section>
</BaseLayout>
